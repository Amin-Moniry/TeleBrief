name: Check Telegram Commands

on:
  schedule:
    - cron: '*/5 * * * *'
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: check-command
  cancel-in-progress: false

jobs:
  check-command:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repo
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.11'

      - name: Install dependencies
        run: pip install telethon requests

      - name: Check for /todaynews command
        env:
          API_ID: ${{ secrets.API_ID }}
          API_HASH: ${{ secrets.API_HASH }}
          SESSION_STRING: ${{ secrets.SESSION_STRING }}
          BOT_TOKEN: ${{ secrets.BOT_TOKEN }}
          MY_CHAT_ID: ${{ secrets.MY_CHAT_ID }}
          XKIRO_API_KEY: ${{ secrets.XKIRO_API_KEY }}
          API_BASE_URL: ${{ secrets.API_BASE_URL }}
          DEFAULT_MODEL: ${{ secrets.DEFAULT_MODEL }}
        run: python command_bot.py

      - name: Commit updated offset
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add bot_state.json
          if git diff --staged --quiet; then
            echo "تغییری تو bot_state.json نبود."
          else
            git commit -m "update telegram offset [skip ci]"
            git pull --rebase origin master
            git push
          fi
